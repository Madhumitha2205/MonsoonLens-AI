# MonsoonLens AI - Environment Configuration Example
# Copy this file to .env and populate with your personal credentials.

# Open Government Data (OGD) Platform India API Key
# Register and generate your free API key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Optional: Application Port and Host settings
PORT=8501
HOST=0.0.0.0
